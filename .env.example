# Identidade visual
NEXT_PUBLIC_APP_NAME=Finança Familiar

# Valores públicos do painel Supabase > Connect
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO

# Somente backend. Nunca use NEXT_PUBLIC_ nestas variáveis.
SUPABASE_SECRET_KEY=sb_secret_EXEMPLO
PII_HASH_KEY=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# URL pública cadastrada também no Supabase Auth e na Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Provedor de confirmação de recuperação (a definir antes da ativação real)
RECOVERY_PROVIDER=disabled
